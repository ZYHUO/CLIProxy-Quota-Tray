{
  "name": "cliproxy-quota-tray",
  "productName": "CLIProxy Quota Tray",
  "version": "1.0.0",
  "description": "Windows tray dashboard for CLIProxyAPI OAuth quota, usage cost and provider status",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": "ZYHUO",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron . --dist",
    "preview:fake": "vite build && node scripts/serve-preview.mjs",
    "package:win": "vite build && electron-packager . \"CLIProxy Quota Tray\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(src|tools|docs|scripts|release|node_modules|\\.git|\\.github)($|/)\" --ignore=\"^/(vite\\.config\\.js|index\\.html|\\.gitignore|README\\.md|AGENT\\.md|LICENSE)$\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "38.4.0",
    "vite": "^6.0.5"
  }
}
